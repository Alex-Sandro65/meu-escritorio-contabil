# App
APP_NAME="ContaMax SaaS"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/contamax
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/contamax

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=sa-east-1
S3_BUCKET=contamax-files

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@contamax.com.br
SMTP_PASSWORD=your-password

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://app.contamax.com.br

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Integrations
SCI_API_URL=https://api.sci.com.br
SCI_API_KEY=your-sci-key
OMIE_APP_KEY=your-omie-key
OMIE_APP_SECRET=your-omie-secret
CONTAAZUL_CLIENT_ID=your-client-id
CONTAAZUL_CLIENT_SECRET=your-client-secret
